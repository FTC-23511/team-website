---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import { nav, emails } from '../data/site';

// The home hero's dot robot (same file and dot count), shown already built.
const POINTS = 174728;

// The places most visitors are looking for, one per audience. Robots is the current season (the menu's first entry).
const ways = [
  { label: 'Home', href: '/' },
  { label: 'Meet the Team', href: '/about/team' },
  { label: 'Robots', href: nav.find((n) => n.label === 'Robots')!.children![0].href },
  { label: 'Resources', href: '/resources' },
  { label: 'LEGO Robotics Classes', href: '/classes' },
  { label: 'Contact', href: '/contact' },
];
---

<Base
  title="Page not found | Seattle Solvers"
  description="There is no page at this address on the Seattle Solvers site."
  noindex
  canonical={false}
>
  <section class="lost" aria-labelledby="lost-title">
    <div class="inner">
      <div class="copy">
        <h1 id="lost-title">404: Page not found</h1>
        <p class="lede">
          There’s no page at <code class="path" data-path>this address</code>. It may have moved when we rebuilt our
          site, or the address has a typo.
        </p>
        <nav class="ways" aria-label="Where to go instead">
          <ul role="list">
            {
              ways.map((w) => (
                <li>
                  <a class="arrow-link" href={w.href}>
                    <span>{w.label}</span>
                    <span class="ring" aria-hidden="true">
                      <Icon name="ph:arrow-right" />
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <p class="report">
          Followed a link on our site to get here? Tell us at <a href={`mailto:${emails.team}`}>{emails.team}</a> and
          we’ll fix it.
        </p>
      </div>

      <!-- The dot robot in its sun, as on the home page: built already, turning until someone takes hold of it. -->
      <div class="stage" data-robot data-src="/models/cypher.bin" data-count={POINTS}>
        <div class="sun" aria-hidden="true"></div>
        <!-- Shown only when the live robot can't run. -->
        <img class="poster" data-src="/images/home/hero-poster.webp" alt="" width="766" height="766" />
        <noscript><img class="poster still" src="/images/home/hero-poster.webp" alt="" width="766" height="766" /></noscript>
        <canvas data-label="Cypher, the team's robot, drawn in dots. Drag or use the arrow keys to rotate it."></canvas>
        <!-- The script shows this group once the robot is live (the renderer's .hint). -->
        <div class="hint" hidden>
          <button class="pause" type="button" aria-pressed="false" aria-label="Pause motion" data-pause>
            <Icon name="ph:pause" class="i-pause" aria-hidden="true" />
            <Icon name="ph:play" class="i-play" aria-hidden="true" />
          </button>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { mountCypher } from '../scripts/cypher';

  // The robot arrives already built and turns slowly, like the home page's, until it is dragged or paused.
  const stage = document.querySelector<HTMLElement>('[data-robot]');
  const robot = stage ? mountCypher(stage, { assembled: true }) : undefined;
  const pause = document.querySelector<HTMLButtonElement>('[data-pause]');
  pause?.addEventListener('click', () => {
    const on = pause.getAttribute('aria-pressed') !== 'true';
    pause.setAttribute('aria-pressed', String(on));
    robot?.setPaused(on);
  });

  // Name the address that wasn't found, so a mistyped link is easy to spot.
  const path = document.querySelector<HTMLElement>('[data-path]');
  if (path) {
    let shown = location.pathname;
    try {
      shown = decodeURI(shown);
    } catch {
      // keep the raw path
    }
    path.textContent = shown.length > 48 ? `${shown.slice(0, 47)}…` : shown;
  }
</script>

<style>
  .lost {
    overflow: hidden;
    isolation: isolate;
  }
  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    align-items: center;
    gap: var(--s-7);
    min-height: calc(100dvh - var(--header-h));
    max-width: 1680px;
    margin-inline: auto;
    padding: var(--s-7) var(--gutter);
  }

  /* The right side is the robot's stage, full height. The script places the robot (from the --robot-* values) and
     writes the sun's centre and size back as --sun-cx, --sun-cy and --sun-d; until then the sun sits centred. */
  .stage {
    --robot-x: 0;
    --robot-y: 0;
    --robot-s: 0.62;
    --robot-fit: 0.98;
    position: relative;
    align-self: stretch;
    min-height: 30rem;
  }
  .sun,
  .poster {
    position: absolute;
    left: var(--sun-cx, 50%);
    top: var(--sun-cy, 53%);
    height: var(--sun-d, min(84%, 38rem));
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
  }
  .sun {
    border-radius: 50%;
    background: radial-gradient(circle at 50% 42%, var(--sun-disk) 0 58%, var(--sun-disk-edge) 100%);
    box-shadow: inset 0 0 0 2px var(--sun-rim);
  }
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    touch-action: pan-y;
  }
  .stage.is-over-robot canvas {
    cursor: grab;
  }
  .stage.is-dragging canvas {
    cursor: grabbing;
  }
  canvas:focus-visible {
    outline: 2px solid var(--gold-deep);
    outline-offset: -6px;
  }
  /* The robot at rest, screened over the sun, when the live one can't run (no WebGL, no JavaScript). */
  .poster {
    mix-blend-mode: screen;
    pointer-events: none;
  }
  .stage:not(.is-fallback) > .poster:not(.still) {
    display: none;
  }
  .stage.is-fallback canvas {
    visibility: hidden;
  }

  /* Pause motion, as on the home page: a small ring at the stage's lower left. */
  .hint {
    position: absolute;
    left: 0;
    bottom: 0;
    z-index: 1;
  }
  .pause {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: color-mix(in srgb, var(--paper) 70%, transparent);
    color: var(--ink);
    cursor: pointer;
    transition:
      background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }
  .pause:hover {
    border-color: var(--ink);
    background: var(--paper);
  }
  .pause :global(svg) {
    width: 14px;
    height: 14px;
  }
  .pause :global(.i-play),
  .pause[aria-pressed='true'] :global(.i-pause) {
    display: none;
  }
  .pause[aria-pressed='true'] :global(.i-play) {
    display: block;
  }
  /* Under reduced motion the robot doesn't turn by itself, so there is nothing to pause. */
  @media (prefers-reduced-motion: reduce) {
    .hint {
      display: none;
    }
  }

  .copy {
    position: relative;
    z-index: 1;
  }
  h1 {
    max-width: 11ch;
    font-size: var(--step-4);
    line-height: 0.98;
  }
  .lede {
    margin-top: var(--s-5);
    max-width: 40ch;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-2);
  }
  .path {
    padding: 0.05em 0.35em;
    font-family: var(--font-mono);
    font-size: 0.8em;
    color: var(--ink);
    background: var(--paper-2);
    border: 1px dashed var(--line-strong);
    overflow-wrap: anywhere;
  }
  .ways {
    margin-top: var(--s-6);
  }
  .ways ul {
    display: grid;
    grid-template-columns: repeat(2, auto);
    justify-content: start;
    gap: 0 var(--s-7);
    margin: 0;
  }
  .report {
    margin-top: var(--s-6);
    max-width: 44ch;
    font-size: 0.9375rem;
    color: var(--ink-3);
  }
  .report a {
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .report a:hover {
    color: var(--gold-ink);
  }

  /* Phones and small tablets: the words first, then the robot's stage beneath them. */
  @media (max-width: 899px) {
    .inner {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
      gap: var(--s-6);
      min-height: 0;
      padding-block: var(--s-7) var(--s-8);
    }
    .stage {
      min-height: 0;
      height: clamp(20rem, 92vw, 32rem);
    }
  }
  @media (max-width: 479px) {
    .ways ul {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
