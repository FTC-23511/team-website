---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import { nav } from '../data/site';

// The places most visitors are looking for, one per audience. Robots is the current season (the menu's first entry).
const ways = [
  { label: 'Home', href: '/' },
  { label: 'Meet the Team', href: '/about/team/' },
  { label: 'Robots', href: nav.find((n) => n.label === 'Robots')!.children![0].href },
  { label: 'Resources', href: '/resources/' },
  { label: 'LEGO Robotics Classes', href: '/classes/' },
  { label: 'Contact', href: '/contact/' },
];
---

<Base
  title="Page not found | Seattle Solvers"
  description="There is no page at this address on the Seattle Solvers site."
  noindex
  canonical={false}
>
  <section class="missing" aria-labelledby="missing-title">
    <div class="sun" aria-hidden="true"></div>
    <h1 id="missing-title">Page not found</h1>
    <p class="lede">There is no page at this address. It may have moved when our site was rebuilt.</p>
    <nav class="ways" aria-label="Where to go instead">
      <ul role="list">
        {
          ways.map((w) => (
            <li>
              <a class="arrow-link" href={w.href}>
                <span>{w.label}</span>
                <span class="ring" aria-hidden="true">
                  <Icon name="ph:arrow-right" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </section>
</Base>

<style>
  .missing {
    position: relative;
    display: grid;
    align-content: center;
    justify-items: start;
    min-height: calc(100dvh - var(--header-h));
    max-width: 1680px;
    margin-inline: auto;
    padding: var(--s-8) var(--gutter);
    overflow: hidden;
    isolation: isolate;
  }
  .sun {
    position: absolute;
    right: -18vw;
    top: 50%;
    width: min(56vw, 720px);
    aspect-ratio: 1;
    border-radius: 50%;
    transform: translateY(-50%);
    background: radial-gradient(circle at 50% 42%, var(--sun-disk) 0 58%, var(--sun-disk-edge) 100%);
    box-shadow: inset 0 0 0 2px var(--sun-rim);
    z-index: -1;
  }
  h1 {
    max-width: 12ch;
    font-size: var(--step-4);
    line-height: 0.98;
  }
  .lede {
    margin-top: var(--s-5);
    max-width: 36ch;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-2);
  }
  .ways {
    margin-top: var(--s-6);
  }
  .ways ul {
    display: grid;
    gap: 0 var(--s-7);
    margin: 0;
  }
  @media (min-width: 1100px) {
    .ways ul {
      grid-template-columns: repeat(2, auto);
    }
  }

  /* As in the page headers: on phones the sun rises from the top corner and the words start below its lowest point. */
  @media (max-width: 767px) {
    .missing {
      --d: min(48vw, 13rem);
      align-content: start;
      padding-top: max(var(--s-8), calc(var(--d) * 0.44 + var(--s-4)));
    }
    .sun {
      width: var(--d);
      right: calc(var(--d) * -0.42);
      top: calc(var(--d) * -0.56);
      transform: none;
    }
  }
</style>
