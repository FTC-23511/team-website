---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import LatestIssue from '../../components/newsletters/LatestIssue.astro';
import Archive from '../../components/newsletters/Archive.astro';
import SponsorsGetIt from '../../components/newsletters/SponsorsGetIt.astro';
import { intro, issues } from '../../data/newsletters';

const [latest, ...back] = issues;
---

<Base
  title="Newsletters | Seattle Solvers"
  description="The Seattle Solvers newsletter: the robot, SolversLib, LEGO robotics classes, outreach, and competitions, from FTC Team #23511."
>
  <PageHeader title="Newsletters" lede={intro} />
  <LatestIssue issue={latest} />
  {back.length > 0 && <Archive issues={back} />}
  <SponsorsGetIt />
</Base>
