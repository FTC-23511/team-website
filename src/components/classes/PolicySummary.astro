---
// The page's close: the four class policies in a line each, where to ask questions, the enrollment status and
// action once more, and the doors for older students and for the curriculum's pilot abroad.
import { Icon } from 'astro-icon/components';
import CopyButton from '../CopyButton.astro';
import StatusLine from './StatusLine.astro';
import { allSessions, forms, policies } from '../../data/classes';
import { emails } from '../../data/site';
import { enrollmentState, signUpHref, todayInSeattle } from './status';

const state = enrollmentState(allSessions, todayInSeattle());
const signUp = signUpHref(allSessions, state);
---

<section class="know" aria-labelledby="know-title">
  <div class="inner">
    <div class="head">
      <h2 id="know-title">Before you sign up</h2>
      <p class="sub">Four policies apply to every class we run.</p>
      <a class="arrow-link" href="/classes/policies">
        <span>Class policies</span>
        <span class="ring" aria-hidden="true"><Icon name="ph:arrow-right" /></span>
      </a>
    </div>

    <dl class="rules">
      {
        policies.items.map((p) => (
          <div class="rule">
            <dt>{p.title}</dt>
            <dd>{p.summary}</dd>
          </div>
        ))
      }
    </dl>

    <div class="close">
      <div class="ask">
        <h3>Questions about a class?</h3>
        <p>
          Email us at <a href={`mailto:${emails.business}?subject=${encodeURIComponent('LEGO robotics classes')}`}
            >{emails.business}</a
          >.
        </p>
        <CopyButton text={emails.business} what="email address" />
      </div>
      <div class="go">
        <StatusLine state={state} />
        {
          signUp && (
            <a
              class="btn btn-primary"
              data-when="open"
              data-enrollment-signup
              hidden={!state.open}
              href={signUp}
              target="_blank"
              rel="noopener"
            >
              <span>Sign up</span>
              <span class="ring" aria-hidden="true"><Icon name="ph:arrow-up-right" /></span>
              <span class="visually-hidden">(opens the sign-up form in a new tab)</span>
            </a>
          )
        }
        <a class="btn btn-primary" data-when="closed" hidden={state.open} href={forms.interest.href} target="_blank" rel="noopener">
          <span>{forms.interest.label}</span>
          <span class="ring" aria-hidden="true"><Icon name="ph:arrow-up-right" /></span>
          <span class="visually-hidden">(opens the interest form in a new tab)</span>
        </a>
      </div>
    </div>

    <ul class="doors" role="list">
      <li>
        <p>Students in grades 7 to 12 can apply to our FIRST Tech Challenge team.</p>
        <a class="arrow-link" href="/apply">
          <span>Join the Team</span>
          <span class="ring" aria-hidden="true"><Icon name="ph:arrow-right" /></span>
        </a>
      </li>
      <li>
        <p>We also wrote a full-year curriculum for rural schools and piloted it in India.</p>
        <a class="arrow-link" href="/impact#rise">
          <span>The RISE School pilot</span>
          <span class="ring" aria-hidden="true"><Icon name="ph:arrow-right" /></span>
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  /* Hairlines on both edges: paper-2 and the night footer are close in value. */
  .know {
    background: var(--paper-2);
    border-block: 1px solid var(--line);
  }
  .inner {
    display: grid;
    grid-template-columns: calc(34% - var(--s-7)) minmax(0, 1fr);
    gap: var(--s-7);
    max-width: 1680px;
    margin-inline: auto;
    padding: var(--s-9) var(--gutter);
  }
  h2 {
    font-size: clamp(2.25rem, 1.2rem + 2vw, 3rem);
  }
  .sub {
    margin-top: var(--s-4);
    max-width: 30ch;
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--ink-2);
  }
  .head .arrow-link {
    margin-top: var(--s-5);
  }

  /* Four rules, two by two, each under its own hairline. */
  .rules {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-6) var(--s-7);
    margin: 0;
    align-content: start;
  }
  .rule {
    padding-top: var(--s-4);
    border-top: 1px solid var(--line-strong);
  }
  dt {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
  }
  dd {
    margin: var(--s-2) 0 0;
    max-width: 44ch;
    color: var(--ink-2);
  }

  .close {
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s-6);
    padding-top: var(--s-6);
    border-top: 1px solid var(--line);
  }
  h3 {
    font-size: 1.25rem;
  }
  .ask p {
    margin-top: var(--s-2);
    margin-bottom: var(--s-4);
    color: var(--ink-2);
  }
  .ask a {
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .ask a:hover {
    color: var(--gold-ink);
  }
  /* The status line over its action, as under the page title. */
  .go {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-4);
  }

  .doors {
    grid-column: 2;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-6) var(--s-7);
    margin: 0;
  }
  .doors p {
    max-width: 38ch;
    font-size: 0.9375rem;
    color: var(--ink-3);
  }
  .doors .arrow-link {
    margin-top: var(--s-2);
  }

  @media (max-width: 1099px) {
    .inner {
      grid-template-columns: 1fr;
      gap: var(--s-6);
    }
    .close,
    .doors {
      grid-column: auto;
    }
  }
  @media (max-width: 767px) {
    .rules,
    .doors {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 599px) {
    .inner {
      padding-block: var(--s-8);
    }
  }
  @media (max-width: 479px) {
    .go,
    .go .btn {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
