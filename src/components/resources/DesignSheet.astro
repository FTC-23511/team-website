---
// One open CAD design as a drawing sheet: the render on a light drawing plate (pale duotone at rest, its own colors
// when reached for), then a title strip with the name, the site's description and the Onshape link.
import { Icon } from 'astro-icon/components';
import type { Design } from '../../data/resources';

interface Props {
  design: Design;
  /** The season's full robot: a taller plate that fills its column. */
  lead?: boolean;
  /** A render in the page's first screen: it loads at once instead of fading in as it arrives. */
  eager?: boolean;
  /** The first of those renders, fetched ahead of everything else. */
  priority?: boolean;
}
const { design, lead = false, eager = false, priority = false } = Astro.props;
const { image } = design;
---

<article class:list={['sheet', { lead }]}>
  <div class="plate">
    <img
      src={image.src}
      alt={image.alt}
      width={image.width}
      height={image.height}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={priority ? 'high' : undefined}
    />
  </div>
  <div class="strip">
    <h3>{design.name}</h3>
    <div class="about">
      {design.description.map((p) => <p>{p}</p>)}
    </div>
    <ul class="actions" role="list">
      <li>
        <a class="arrow-link" href={design.href} target="_blank" rel="noopener">
          <span>Open in Onshape<span class="visually-hidden">: {design.name} (opens in a new tab)</span></span>
          <span class="ring" aria-hidden="true"><Icon name="ph:arrow-up-right" /></span>
        </a>
      </li>
      {
        design.robot && (
          <li>
            <a class="arrow-link" href={design.robot.href}>
              <span>Meet {design.robot.name}</span>
              <span class="ring" aria-hidden="true">
                <Icon name="ph:arrow-right" />
              </span>
            </a>
          </li>
        )
      }
    </ul>
  </div>
</article>

<style>
  /* A drawing sheet: one hairline frame around the plate and its title strip. */
  .sheet {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--line-strong);
  }

  /* The light plate is a deliberate island: renders of black aluminum and carbon need a light ground to read.
     Like a sponsor mark on its plate, the render rests in gray and eases to its own colors when the sheet is
     reached for, on the site's 0.65s in / 0.9s out rhythm. */
  .plate {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--plate);
    overflow: hidden;
  }
  .lead .plate {
    flex: 1;
    aspect-ratio: auto;
    min-height: 26rem;
  }
  .plate img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: clamp(1rem, 0.5rem + 2vw, 2.5rem);
  }

  .strip {
    display: grid;
    gap: var(--s-4);
    padding: var(--s-5) var(--s-5) var(--s-5);
    border-top: 1px solid var(--line-strong);
  }
  h3 {
    font-size: var(--step-2);
  }
  .about {
    display: grid;
    gap: var(--s-2);
    max-width: 60ch;
  }
  .about p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .about p:first-child {
    color: var(--ink);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--s-5);
    margin: 0;
  }

  @media (max-width: 599px) {
    .strip {
      padding: var(--s-4);
    }
    .lead .plate {
      flex: none;
      aspect-ratio: 1;
      min-height: 0;
    }
  }
</style>
