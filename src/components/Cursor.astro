---
// A circle with a dot in the middle, sitting exactly on the pointer. Mouse and trackpad only; touch
// keeps native behavior. Over links the circle opens wider, over selectable text it gives way to a
// text bar, and on the robot itself (inside its sun, or while dragging it) it steps aside for the
// native grab hand. Position is written straight from each pointer event, so it never lags.
---

<div class="cursor" data-cursor aria-hidden="true">
  <span class="c-ring"></span>
  <span class="c-dot"></span>
</div>

<style is:global>
  /* Forced colors (Windows High Contrast) would wash the drawn cursor out, so the system pointer stays. */
  @media (forced-colors: active) {
    html.has-cursor,
    html.has-cursor * {
      cursor: auto !important;
    }
    .cursor {
      display: none;
    }
  }
  @media (hover: hover) and (pointer: fine) {
    html.has-cursor,
    html.has-cursor * {
      cursor: none !important;
    }
    html.has-cursor :is(input, textarea, select, [contenteditable='true']) {
      cursor: text !important;
    }
    html.has-cursor [data-cypher].is-over-robot canvas {
      cursor: grab !important;
    }
    html.has-cursor [data-cypher].is-dragging canvas {
      cursor: grabbing !important;
    }
  }

  .cursor {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 100;
    width: 0;
    height: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s var(--ease-soft);
    will-change: transform;
  }
  .cursor.is-visible {
    opacity: 1;
  }
  .cursor.is-hidden {
    opacity: 0;
  }
  .c-dot,
  .c-ring {
    position: absolute;
    left: 0;
    top: 0;
    border-radius: 50%;
  }
  .c-dot {
    width: 6px;
    height: 6px;
    margin: -3px 0 0 -3px;
    background: var(--cursor-fill);
    box-shadow: 0 0 0 1.5px var(--cursor-halo);
    transition:
      transform 0.16s var(--ease),
      border-radius 0.16s var(--ease);
  }
  .c-ring {
    width: 30px;
    height: 30px;
    margin: -15px 0 0 -15px;
    border: 1.5px solid var(--cursor-fill);
    box-shadow:
      0 0 0 1px var(--cursor-halo),
      inset 0 0 0 1px var(--cursor-halo);
    transition:
      opacity 0.16s var(--ease-soft),
      transform 0.22s var(--ease);
  }
  /* Links and buttons: the circle opens wider around the target; the dot shrinks to its center. */
  .cursor.is-link .c-ring {
    transform: scale(1.45);
  }
  .cursor.is-link .c-dot {
    transform: scale(0.7);
  }
  .cursor.is-down .c-ring {
    transform: scale(0.82);
  }
  .cursor.is-link.is-down .c-ring {
    transform: scale(1.25);
  }
  /* Selectable text: the circle gives way to a slim text bar. */
  .cursor.is-text .c-ring {
    opacity: 0;
    transform: scale(0.5);
  }
  .cursor.is-text .c-dot {
    transform: scale(0.4, 3.3);
    border-radius: 0;
  }
  .cursor.is-down .c-dot {
    transform: scale(0.7);
  }
  .cursor.is-down.is-text .c-dot {
    transform: scale(0.4, 3.3);
  }
</style>

<script>
  const el = document.querySelector<HTMLElement>('[data-cursor]');
  const forced = matchMedia('(forced-colors: active)');
  if (el && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    // In forced colors the system pointer is kept (and any enlarged pointer the visitor has set).
    const sync = () => document.documentElement.classList.toggle('has-cursor', !forced.matches);
    sync();
    forced.addEventListener('change', sync);
    let x = -100, y = -100, shown = false, pending = 0;

    const TEXT = 'p, h1, h2, h3, h4, li, dd, dt, blockquote, figcaption, td, th, cite';
    const LINK = 'a, button, [role="button"], label, summary, select';
    const FIELD = 'input, textarea, [contenteditable="true"]';
    // Photos, drawings and players inside a text block (a roster card, an event entry) are not text.
    const MEDIA = 'img, picture, video, canvas, svg, iframe';

    const setState = (t: Element | null) => {
      // On the robot itself the native grab hand takes over; the dot and ring step aside.
      const robot = !!t?.closest('[data-cypher].is-over-robot canvas');
      const link = !robot && !!t?.closest(LINK);
      el.classList.toggle('is-hidden', robot || !!t?.closest(FIELD));
      el.classList.toggle('is-link', link);
      el.classList.toggle('is-text', !robot && !link && !t?.closest(MEDIA) && !!t?.closest(TEXT));
    };

    addEventListener(
      'pointermove',
      (e) => {
        // A pen hovers like a mouse; only touch has no pointer to draw.
        if (e.pointerType === 'touch') return;
        x = e.clientX;
        y = e.clientY;
        el.style.transform = `translate3d(${x}px, ${y}px, 0)`;
        if (!shown) {
          shown = true;
          el.classList.add('is-visible');
        }
        setState(e.target instanceof Element ? e.target : null);
      },
      { passive: true },
    );

    // When the page scrolls under a still mouse, re-read what is under it (once per frame).
    addEventListener(
      'scroll',
      () => {
        if (!shown || pending) return;
        pending = requestAnimationFrame(() => {
          pending = 0;
          setState(document.elementFromPoint(x, y));
        });
      },
      { passive: true },
    );

    document.documentElement.addEventListener('mouseleave', () => {
      el.classList.remove('is-visible');
      shown = false;
    });
    addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'touch') el.classList.add('is-down');
    });
    addEventListener('pointerup', () => el.classList.remove('is-down'));
    // Starting a video moves focus into its player, which draws its own pointer: step aside until the mouse is back
    // on the page. (Switching windows also blurs, but then the drawn cursor should stay where it was.)
    addEventListener('blur', () => {
      el.classList.remove('is-down');
      if (document.activeElement instanceof HTMLIFrameElement) {
        el.classList.remove('is-visible');
        shown = false;
      }
    });
  }
</script>
