---
// The page's close: the team's awards together, from its FIRST LEGO League years to DECODE, with two of its robots.
---

<section class="collection" aria-label="Our awards together">
  <figure>
    <div class="duo frame">
      <img
        src="/images/awards/collection.webp"
        alt="Enigma and Riptide on a field surrounded by the team's award plaques and trophies, from FIRST LEGO League to DECODE"
        width="1600"
        height="1200"
        loading="lazy"
        decoding="async"
      />
    </div>
    <figcaption>Our awards so far, from FIRST LEGO League to DECODE, with Enigma and Riptide.</figcaption>
  </figure>
</section>

<style>
  .collection {
    border-top: 1px solid var(--line);
  }
  figure {
    max-width: 1680px;
    margin: 0 auto;
    padding: var(--s-9) var(--gutter);
  }
  .frame {
    aspect-ratio: 16 / 9;
  }
  .frame img {
    object-position: 50% 60%;
  }
  figcaption {
    margin-top: var(--s-4);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  @media (max-width: 767px) {
    figure {
      padding-block: var(--s-8);
    }
    .frame {
      aspect-ratio: 4 / 3;
    }
  }
</style>
