---
// Back issues, newest first. Each season is marked the way a drawing marks a span: a dimension line over the
// issues it covers, so the groups read as one run of time that wraps from row to row.
import { Icon } from 'astro-icon/components';
import { bySeason, type Issue } from '../../data/newsletters';

interface Props {
  issues: Issue[];
}
const { issues } = Astro.props;
const seasons = bySeason(issues);

// A cover fills one column: 7rem beside its words on phones, a third of the row to 1099px, a fifth above.
const coverSizes = '(max-width: 599px) 112px, (max-width: 1099px) 30vw, 18vw';
---

<section class="archive" aria-labelledby="archive-title">
  <div class="inner">
    <h2 id="archive-title">Back issues</h2>

    <ol class="seasons" role="list">
      {
        seasons.map((s) => (
          <li class="season" style={`--n: ${Math.min(s.issues.length, 3)}`}>
            <p class="span">
              <span class="span-label">{s.season}</span>
            </p>
            <ol class="issues" role="list">
              {s.issues.map((issue) => (
                <li class="issue">
                  <a class="cover duo" href={issue.href} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
                    <img
                      src={issue.cover}
                      srcset={issue.coverSmall && `${issue.coverSmall} 360w, ${issue.cover} 880w`}
                      sizes={issue.coverSmall && coverSizes}
                      alt=""
                      width="880"
                      height="1140"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                  <div class="words">
                    <h3>{issue.period}</h3>
                    <ul class="topics" role="list">
                      {issue.topics.map((t) => (
                        <li>{t}</li>
                      ))}
                    </ul>
                    <a class="arrow-link" href={issue.href} target="_blank" rel="noopener">
                      <span>
                        Read<span class="visually-hidden"> the {issue.period} issue (opens in a new tab)</span>
                      </span>
                      <span class="ring" aria-hidden="true">
                        <Icon name="ph:arrow-up-right" />
                      </span>
                    </a>
                  </div>
                </li>
              ))}
            </ol>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .archive {
    border-top: 1px solid var(--line);
  }
  .inner {
    max-width: 1680px;
    margin-inline: auto;
    padding: var(--s-9) var(--gutter);
  }
  h2 {
    font-size: clamp(2.25rem, 1.2rem + 2vw, 3rem);
    margin-bottom: var(--s-7);
  }

  /* Five columns; each season spans as many as it has issues, and the issues sit on those same columns. */
  .seasons {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--s-8) var(--s-5);
    margin: 0;
  }
  /* A season's issues fill the height of the tallest season in their row, so every Read link lands on one line. */
  .season {
    grid-column: span var(--n);
    display: grid;
    grid-template-columns: subgrid;
    grid-template-rows: auto 1fr;
    align-content: stretch;
  }
  .issues {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    row-gap: var(--s-7);
    margin: 0;
  }

  /* The dimension line: a hairline with a tick at each end, the season named beneath it. */
  .span {
    grid-column: 1 / -1;
    position: relative;
    margin-bottom: var(--s-5);
    padding-top: var(--s-3);
    border-top: 1px solid var(--line-strong);
  }
  .span::before,
  .span::after {
    content: '';
    position: absolute;
    top: -6px;
    width: 1px;
    height: 11px;
    background: var(--line-strong);
  }
  .span::before {
    left: 0;
  }
  .span::after {
    right: 0;
  }
  .span-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    color: var(--gold-ink);
  }

  .issue {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .cover {
    display: block;
    aspect-ratio: 880 / 1140;
  }
  .cover img {
    object-position: 50% 0;
  }
  /* Reaching for any part of an issue brings its cover back to color, on the duotone's own rhythm. */
  @media (hover: hover) {
    .issue:hover .cover img,
    .issue:focus-within .cover img {
      filter: grayscale(0) contrast(1) brightness(1);
      transition-duration: 0.65s, 1.4s;
    }
    .issue:hover .cover::after,
    .issue:focus-within .cover::after {
      opacity: 0;
      transition-duration: 0.65s;
    }
  }

  .words {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding-top: var(--s-4);
  }
  h3 {
    font-size: var(--step-1);
    line-height: 1.3;
  }
  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5rem;
    margin: var(--s-2) 0 var(--s-3);
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--ink-3);
  }
  .topics li:not(:last-child)::after {
    content: '/';
    margin-left: 0.5rem;
    color: var(--line-strong);
  }
  .arrow-link {
    margin-top: auto;
    align-self: flex-start;
  }

  @media (max-width: 1099px) {
    .seasons {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 767px) {
    .inner {
      padding-block: var(--s-8);
    }
  }
  /* Phones: one column, each issue a row with its cover beside the words. */
  @media (max-width: 599px) {
    h2 {
      margin-bottom: var(--s-6);
    }
    .seasons {
      grid-template-columns: 1fr;
      row-gap: var(--s-7);
    }
    /* A season spanning two columns in a one-column grid would add an implicit column; reset the span. */
    .season {
      grid-column: auto;
    }
    .season,
    .issues {
      display: block;
    }
    .issue {
      display: grid;
      grid-template-columns: 7rem minmax(0, 1fr);
      gap: var(--s-4);
      align-items: start;
    }
    .issue + .issue {
      margin-top: var(--s-5);
      padding-top: var(--s-5);
      border-top: 1px solid var(--line);
    }
    .words {
      padding-top: 0;
    }
    h3 {
      font-size: 1.0625rem;
    }
    .topics {
      font-size: 0.875rem;
    }
  }
</style>
