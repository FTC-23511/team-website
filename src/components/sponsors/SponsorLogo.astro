---
// One sponsor's logo on the Sponsors page's light ground: in its own colors, with no plate. Its size comes from the
// tier (see logoSize.ts), and it grows a little under the pointer or keyboard focus.
import type { Sponsor } from '../../data/home';
import { logoSize, type LogoTier } from './logoSize';

interface Props {
  sponsor: Sponsor;
  size: LogoTier;
  eager?: boolean;
}
const { sponsor: s, size, eager = false } = Astro.props;
const { width } = logoSize(s, size);
const style = `--lw: ${width}rem; --lr: ${s.ratio}`;
const img = { src: s.logo, alt: s.caption ? '' : s.name, loading: eager ? 'eager' : 'lazy', decoding: 'async' } as const;
---

{
  s.href ? (
    <a class="logo" href={s.href} target="_blank" rel="sponsored noopener" style={style}>
      <img {...img} />
      {s.caption && <span class="caption">{s.name}</span>}
      <span class="visually-hidden"> (opens in a new tab)</span>
    </a>
  ) : (
    <span class="logo" style={style}>
      <img {...img} />
      {s.caption && <span class="caption">{s.name}</span>}
    </span>
  )
}

<style>
  .logo {
    display: inline-flex;
    flex-direction: column;
    align-items: var(--logo-align, center);
    gap: var(--s-2);
    max-width: 100%;
    color: inherit;
    text-decoration: none;
  }
  img {
    width: var(--lw);
    max-width: 100%;
    height: auto;
    aspect-ratio: var(--lr);
    object-fit: contain;
    transform-origin: var(--logo-origin, center);
    transition: transform var(--dur) var(--ease);
  }
  .logo:hover img,
  .logo:focus-visible img {
    transform: scale(1.1);
  }
  .caption {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-2);
    white-space: nowrap;
  }
</style>
