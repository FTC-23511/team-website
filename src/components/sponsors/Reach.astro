---
// Where a sponsor's logo is seen: the social reach figures from the sponsorship package (PDF page 4),
// set as one run of type with the figures inline. Big stand-alone numerals stay special to the home page.
import { reach } from '../../data/sponsors';

const f = Object.fromEntries(reach.figures.map((x) => [x.label, x.value]));
---

<section class="reach" aria-labelledby="reach-title">
  <div class="inner">
    <h2 id="reach-title">Our reach</h2>
    <p class="run">
      Our channels reach <strong>{reach.headline.value}</strong> people online: <strong
        >{f['Website visits']}</strong
      > visits to our website, <strong>{f['Discord members']}</strong> members in our public Discord server, <strong
        >{f['YouTube views']}</strong
      > YouTube views and <strong>{f['YouTube subscribers']}</strong> subscribers, and <strong
        >{f['Instagram viewers']}</strong
      > viewers on Instagram in the last three months.
    </p>
    <p class="source">{reach.source}</p>
  </div>
</section>

<style>
  .reach {
    position: relative;
    background: var(--night);
    color: var(--on-night);
    overflow: hidden;
    isolation: isolate;
  }
  /* A dim sun rising behind the sentence, the night panel's signature. */
  .reach::before {
    content: '';
    position: absolute;
    left: -14%;
    bottom: -60%;
    width: min(64vw, 820px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--night-2);
    z-index: -1;
  }
  .inner {
    max-width: 1680px;
    margin-inline: auto;
    padding: var(--s-9) var(--gutter);
  }
  h2 {
    font-size: clamp(2.25rem, 1.2rem + 2vw, 3rem);
  }
  .run {
    margin-top: var(--s-6);
    max-width: 34ch;
    font-size: clamp(1.625rem, 1.05rem + 1.9vw, 2.75rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  strong {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--sun);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .source {
    margin-top: var(--s-5);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--on-night-2);
  }

  @media (max-width: 599px) {
    .inner {
      padding-block: var(--s-8);
    }
  }
</style>
