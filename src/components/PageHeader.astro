---
// Opening band for every inner page: the title in Orbitron, an optional lede, and a sun rising at the edge.
import { titleFit } from './titleFit';

interface Props {
  title: string;
  lede?: string;
}
const { title, lede } = Astro.props;

// The title's size is capped so its longest word always fits the line on a narrow phone (see titleFit).
const fit = titleFit(title);
---

<header class="page-head">
  <div class="sun" aria-hidden="true"></div>
  <div class="inner">
    <h1 style={`--fit: ${fit.toFixed(3)}`}>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</header>

<style>
  .page-head {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    border-bottom: 1px solid var(--line);
  }
  .sun {
    position: absolute;
    right: -8vw;
    top: 50%;
    width: min(46vw, 560px);
    aspect-ratio: 1;
    border-radius: 50%;
    transform: translateY(-38%);
    background: radial-gradient(circle at 50% 42%, var(--sun-disk) 0 58%, var(--sun-disk-edge) 100%);
    box-shadow: inset 0 0 0 2px var(--sun-rim);
    z-index: -1;
  }
  .inner {
    max-width: 1680px;
    margin-inline: auto;
    padding: var(--s-9) var(--gutter) var(--s-8);
  }
  h1 {
    max-width: 16ch;
    /* Only breaks inside a word if a reader's own text spacing makes it wider than the line. */
    overflow-wrap: break-word;
    font-size: min(var(--step-page-title), calc((100vw - 2 * var(--gutter)) / var(--fit, 8)));
  }
  .lede {
    margin-top: var(--s-5);
    max-width: 52ch;
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--ink-2);
  }

  /* Desktop: the words keep to the left of the sun's column, so its rim never crosses a title, lede or index. */
  @media (min-width: 1100px) {
    .inner {
      padding-right: calc(min(46vw, 560px) - 8vw + var(--s-6));
    }
  }
  /* Tablets: the lede runs nearly the full width, so the sun rises from the top corner here too, larger. The title
     keeps to the left of the disk (its left edge is at 76vw), so a one-line title wraps instead of running under it. */
  @media (min-width: 768px) and (max-width: 1099px) {
    .sun {
      width: 36vw;
      right: -12vw;
      top: -16vw;
      transform: none;
    }
    h1 {
      max-width: min(16ch, calc(76vw - var(--gutter) - var(--s-5)));
    }
  }
  @media (max-width: 767px) {
    /* On phones the sun rises from the top corner, and the words start below its lowest point, so the rim never
       crosses a title or a lede however long the title runs. */
    .page-head {
      --d: min(48vw, 13rem);
    }
    .sun {
      width: var(--d);
      right: calc(var(--d) * -0.42);
      top: calc(var(--d) * -0.56);
      transform: none;
    }
    .inner {
      padding: max(var(--s-8), calc(var(--d) * 0.44 + var(--s-4))) var(--gutter) var(--s-7);
    }
  }
</style>
