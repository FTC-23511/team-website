---
// A robot cut out of its background, in its own colors, standing on whatever is behind it (a sun, a band).
import type { Img } from '../../data/robots';

interface Props {
  img: Img;
  eager?: boolean;
  class?: string;
}
const { img, eager = false, class: className } = Astro.props;
---

<span class:list={['cutout', className]}>
  <img
    src={img.src}
    alt={img.alt}
    width={img.width}
    height={img.height}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={eager ? 'high' : undefined}
  />
</span>

<style>
  .cutout {
    position: relative;
    display: block;
  }
  .cutout img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
