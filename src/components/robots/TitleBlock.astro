---
// The robot's specifications as a drawing title block: a ruled grid of cells, each a mono label over its value.
import type { Spec } from '../../data/robots';

interface Props {
  id: string;
  name: string;
  summary: string;
  specs: Spec[];
}
const { id, name, summary, specs } = Astro.props;
---

<section class="drawing" aria-labelledby={`${id}-robot`}>
  <div class="inner">
    <div class="head">
      <h2 id={`${id}-robot`}>{name}</h2>
      <p class="summary">{summary}</p>
    </div>
    <dl class="block">
      {
        specs.map((s) => (
          <div class="cell">
            <dt>{s.label}</dt>
            <dd>
              <span class="value">{s.value}</span>
              {s.note && <span class="note">{s.note}</span>}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.1fr);
    gap: var(--s-7);
    align-items: start;
    max-width: 1680px;
    margin-inline: auto;
    padding: var(--s-9) var(--gutter);
  }
  h2 {
    font-size: clamp(2.25rem, 1.2rem + 2vw, 3rem);
  }
  .summary {
    margin-top: var(--s-5);
    max-width: 34ch;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-2);
  }

  /* The title block: a frame of strong hairlines, cells divided by the lighter ones. */
  .block {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    border: 1px solid var(--line-strong);
  }
  .cell {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    min-height: 8.5rem;
    padding: var(--s-4) var(--s-5) var(--s-5);
    border-left: 1px solid var(--line);
  }
  .cell:nth-child(4n + 1) {
    border-left: 0;
  }
  .cell:nth-child(n + 5) {
    border-top: 1px solid var(--line);
  }
  dt {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  dd {
    display: grid;
    gap: 0.3rem;
    margin: 0;
  }
  .value {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }
  .note {
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--ink-3);
  }

  @media (max-width: 1099px) {
    .inner {
      grid-template-columns: 1fr;
      gap: var(--s-6);
    }
  }
  @media (max-width: 767px) {
    .inner {
      padding-block: var(--s-8);
    }
    .block {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .cell {
      min-height: 7rem;
      padding: var(--s-4);
    }
    .cell:nth-child(4n + 1) {
      border-left: 1px solid var(--line);
    }
    .cell:nth-child(odd) {
      border-left: 0;
    }
    .cell:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
    .value {
      font-size: 1.0625rem;
    }
  }
</style>
