---
// The robot page's closing ask: sponsors' logos ride on the robot (a benefit from the first tier, per the package).
// The standard Sponsor us block beside a link to the sponsors; the seal stays the Sponsors pages' own close.
import { Icon } from 'astro-icon/components';
import { cta } from '../../data/site';
import { tiers } from '../../data/sponsors';

const first = tiers[0];
---

<section class="close" aria-labelledby="robot-close-title">
  <div class="inner">
    <h2 id="robot-close-title">Your logo on our robot</h2>
    <p class="sub">
      Every sponsor’s logo goes on our robot, team apparel, and website, starting with the {first.name} tier at{' '}
      {first.from}.
    </p>
    <div class="actions">
      <a class="btn btn-primary" href={cta.sponsor.href}>
        <span>{cta.sponsor.label}</span>
        <span class="ring" aria-hidden="true"><Icon name="ph:arrow-right" /></span>
      </a>
      <a class="arrow-link" href="/sponsors/">
        <span>Our sponsors</span>
        <span class="ring" aria-hidden="true"><Icon name="ph:arrow-right" /></span>
      </a>
    </div>
  </div>
</section>

<style>
  .close {
    border-block: 1px solid var(--line);
    background: var(--paper-2);
  }
  .inner {
    max-width: 1680px;
    margin-inline: auto;
    padding: var(--s-9) var(--gutter);
  }
  h2 {
    font-size: clamp(2.25rem, 1.2rem + 2vw, 3rem);
  }
  .sub {
    margin-top: var(--s-5);
    max-width: 46ch;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-2);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-6);
    margin-top: var(--s-6);
  }

  @media (max-width: 599px) {
    .inner {
      padding-block: var(--s-8);
    }
  }
  @media (max-width: 479px) {
    .actions .btn {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
